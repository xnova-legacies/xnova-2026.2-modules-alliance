<div class="card xnova-panel border-0 shadow-sm mb-3">
	<div class="card-header fw-semibold">{search_alliance}</div>
	<div class="card-body">
		<form action="" method="POST" class="d-flex flex-wrap align-items-end gap-2">
			<div class="flex-grow-1">
				<label class="form-label" for="searchtext">{Search}</label>
				<input class="form-control" type="text" id="searchtext" name="searchtext" value="{searchtext}">
			</div>
			<button class="btn btn-primary" type="submit"><i class="bi bi-search" aria-hidden="true"></i> {Search}</button>
		</form>
	</div>
</div>
