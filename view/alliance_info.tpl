<div class="card xnova-panel border-0 shadow-sm mb-3">
	<div class="card-header fw-semibold">Informations sur l'alliance</div>
	<div class="card-body">
		{ally_image}
		<table class="table table-sm align-middle mb-3">
			<tbody>
				<tr>
					<td class="xnova-label" width="30%">Tag</td>
					<td>{ally_tag}</td>
				</tr>
				<tr>
					<td class="xnova-label">Nom</td>
					<td>{ally_name}</td>
				</tr>
				<tr>
					<td class="xnova-label">Membres</td>
					<td>{ally_members}</td>
				</tr>
				{ally_web}
			</tbody>
		</table>
		<div class="xnova-ally-text">{ally_description}</div>
	</div>
</div>
