	<div class="card-body">
		{ally_image}
		<table class="table table-sm align-middle mb-3">
			<tbody>
				<tr>
					<td class="xnova-label" width="30%">{Tag}</td>
					<td>{ally_tag}</td>
				</tr>
				<tr>
					<td class="xnova-label">{Name}</td>
